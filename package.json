{
  "name": "vue-doc-rag",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Portfolio de Thomas Béné : site Vue, avec des projets en React et en Angular intégrés comme Web Components.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:fetch": "git clone --depth 1 https://github.com/vuejs/docs.git data/vue-docs",
    "ingest": "tsx src/ingest/run.ts",
    "embed": "tsx src/ingest/embed.ts",
    "search": "tsx src/ingest/search.ts",
    "dev": "concurrently -n server,web,agp -c green,cyan,red \"npm:dev:server\" \"npm:dev:web\" \"npm:dev:agp\"",
    "dev:server": "tsx watch --env-file=.env src/server/index.ts",
    "dev:web": "vite web",
    "dev:agp": "npm --prefix widgets/agp-angular run watch",
    "build:agp": "npm --prefix widgets/agp-angular run build",
    "build": "npm run build:agp && vite build web",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p web && tsc --noEmit -p widgets/visualizer-react",
    "install:widgets": "npm ci --prefix widgets/agp-angular"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@huggingface/transformers": "^3.5.0",
    "dompurify": "^3.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "marked": "^15.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.19.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.2.0"
  }
}
