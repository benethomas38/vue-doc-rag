{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "newProjectRoot": "projects",
  "projects": {
    "agp-angular": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "index": false,
            "outputPath": { "base": "../../web/public/widgets/agp", "browser": "" },
            "outputHashing": "none",
            "deleteOutputPath": true
          },
          "configurations": {
            "production": {
              "budgets": [{ "type": "initial", "maximumWarning": "200kB", "maximumError": "350kB" }]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
