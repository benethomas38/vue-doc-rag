# Copie ce fichier en .env et mets ta vraie clé (ne commite jamais .env)
ANTHROPIC_API_KEY=sk-ant-...
# Optionnel : claude-haiku-5-5 (par défaut, rapide) ou claude-sonnet-5-5 (meilleures réponses)
CLAUDE_MODEL=claude-haiku-5-5
PORT=3001
# En production uniquement : ton nom de domaine, sans https:// ni www
DOMAIN=thomasbene.fr
# Protection de la clé API (optionnel)
RATE_LIMIT_PER_HOUR=10
DAILY_LIMIT=200
# Assistant AGP : chaque demande fait plusieurs appels à Claude (un par étape), d'où des limites plus basses
AGENT_PER_HOUR=6
AGENT_DAILY_LIMIT=100
# Optionnel : un autre modèle pour l'agent (par défaut le même que CLAUDE_MODEL)
# AGENT_MODEL=claude-haiku-5-5
# Le Donjon qui parle : une réplique = un appel court (300 tokens max), d'où des limites plus larges
GAME_PER_HOUR=40
GAME_DAILY_LIMIT=600
# Optionnel : un autre modèle pour les PNJ (par défaut le même que CLAUDE_MODEL)
# GAME_MODEL=claude-haiku-5-5
